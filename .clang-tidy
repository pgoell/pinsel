# Every finding fails the lint. Turn a check off here, with the reason, rather
# than with NOLINT in the code.
#
# cppcoreguidelines-owning-memory is off: Qt widgets are created with `new` and
# owned by their parent, which deletes them.
#
# bugprone-reserved-identifier allows the __sanitizer_ functions: the memory
# tests declare them, since not every clang-tidy ships the sanitizer headers.
Checks: >
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-owning-memory
WarningsAsErrors: "*"
HeaderFilterRegex: "/(src|tests)/"
CheckOptions:
  readability-function-cognitive-complexity.Threshold: 15
  bugprone-reserved-identifier.AllowedIdentifiers: "^__sanitizer_"
